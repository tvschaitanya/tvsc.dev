<style>
  .architecture { margin-block:48px; }
  .diagram-heading { display:flex;align-items:center;justify-content:space-between;gap:20px; }
  h2 { font-size:clamp(24px,3vw,30px);line-height:1.15;margin-bottom:16px;letter-spacing:-.035em; }
  .diagram-intro { max-width:76ch;color:var(--muted);line-height:1.75; }
  .diagram-scroll { overflow-x:auto;border:1px solid var(--line);border-radius:4px;background:var(--surface);padding:16px; }
  .flow-diagram { display:block;width:100%;min-width:900px; }
  .diagram-note { color:var(--muted);font-size:12px;margin:12px 0 0; }
  #flow { --card:var(--surface);--flow-accent:var(--orange);--fe:var(--muted);--be:var(--orange);--cloud:var(--muted);--sec:var(--muted);--ext:var(--muted);--db:var(--muted); }
  #flow .e-main { --c:var(--flow-accent); } #flow .e-plain { --c:var(--muted); } #flow .e-sec { --c:var(--sec); } #flow .e-dash { --c:var(--cloud); }
  #flow .edge { stroke:var(--c);stroke-width:1.8;stroke-opacity:.6; } #flow .edge.e-dash { stroke-dasharray:5 4; }
  #flow .m-main { fill:var(--flow-accent); } #flow .m-plain { fill:var(--muted); } #flow .m-sec { fill:var(--sec); } #flow .m-dash { fill:var(--cloud); }
  #flow .pill rect { fill:var(--card);stroke:var(--c);stroke-opacity:.4; } #flow .pill text { fill:var(--c); }
  #flow .frame { fill:color-mix(in srgb,var(--cloud) 6%,transparent);stroke:var(--cloud);stroke-dasharray:4 4; } #flow .frame-label { fill:var(--cloud); }
  #flow .t-fe { --c:var(--fe); } #flow .t-be { --c:var(--be); } #flow .t-db { --c:var(--db); } #flow .t-cloud { --c:var(--cloud); } #flow .t-sec { --c:var(--sec); } #flow .t-ext { --c:var(--ext); }
  #flow .node rect { fill:color-mix(in srgb,var(--c) 9%,var(--card));stroke:var(--c);stroke-width:1.5; }
  #flow .node .nl { fill:var(--ink); } #flow .node .ns { fill:var(--muted); }
</style>
