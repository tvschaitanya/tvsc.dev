---
const contact = {
    siteName: "Chaitanya's Portfolio",
    email: "tvschaitanya@outlook.com",
    description:
        "I’m open to opportunities in cloud and AI, thoughtful conversations, and learning from others. Feel free to say hello.",
};
const socialLinks = [
    { label: "LinkedIn", href: "https://www.linkedin.com/in/tvschaitanya" },
    { label: "GitHub", href: "https://github.com/tvschaitanya" },
    { label: "Hashnode", href: "https://tvschaitanya.hashnode.dev/" },
];
import SectionLabel from "./ui/SectionLabel.astro";
import Icon from "./ui/Icon.astro";
import SectionArtwork from "./SectionArtwork.astro";
---

<footer id="contact" aria-labelledby="contact-title">
    <div class="section closing">
        <div class="wrap">
            <SectionLabel number="05" label="Contact" />
            <div class="contact-layout">
                <div class="contact-content">
                    <h2 id="contact-title">
                        Let’s connect<span class="accent">.</span>
                    </h2>
                    <p class="contact-description">{contact.description}</p>
                    <nav class="contact-links" aria-label="Contact links">
                        <a href={`mailto:${contact.email}`}>
                            <span>Email</span>
                            <Icon size={18} />
                        </a>
                        {socialLinks.map((link) => (
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <span>{link.label}</span>
                                <Icon size={18} />
                            </a>
                        ))}
                    </nav>
                </div>
                <SectionArtwork variant="contact" />
            </div>
        </div>
    </div>
    <div class="footer-base">
        <div class="wrap footer-bottom">
            <span>
                {contact.siteName} <span class="copyright">© 2026</span>
            </span>
            <a
                class="back-to-top"
                href="#home"
                aria-label="Back to top"
                title="Back to top"
            >
                <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <path d="M12 19V5m-6 6 6-6 6 6" />
                </svg>
            </a>
        </div>
    </div>
</footer>

<style>
    .closing {
        background: var(--blue);
        color: var(--paper);
        --ink: var(--paper);
        --accent: var(--orange);
        --muted: color-mix(in srgb, var(--paper) 82%, var(--blue));
        --line: color-mix(in srgb, var(--paper) 35%, transparent);
        padding-bottom: 88px;
    }
    .contact-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
        gap: 64px;
        align-items: center;
    }
    .contact-content {
        max-width: 680px;
        min-width: 0;
    }
    .closing h2 {
        font-size: clamp(52px, 6.5vw, 88px);
        letter-spacing: -0.055em;
        line-height: 1.05;
        margin: 0 0 24px;
    }
    .contact-description {
        max-width: 560px;
        font-size: 18px;
        line-height: 1.75;
        color: var(--muted);
        margin: 0 0 32px;
    }
    .contact-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px 24px;
    }
    .contact-links a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 48px;
        padding: 8px 0;
        border-bottom: 1px solid var(--paper);
        font-size: 18px;
        font-weight: 500;
        letter-spacing: -0.02em;
        white-space: nowrap;
    }
    .contact-links :global(svg) {
        color: var(--orange);
        flex-shrink: 0;
        transition: transform 160ms var(--ease-out);
    }
    .footer-base {
        background: var(--bg);
        color: var(--muted);
        border-top: 1px solid var(--line);
    }
    .footer-bottom {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 96px;
        padding-block: 24px;
        font-size: 12px;
        text-align: center;
    }
    .copyright {
        margin-left: 16px;
    }
    .back-to-top {
        position: absolute;
        right: 0;
        bottom: 24px;
        display: grid;
        place-items: center;
        width: 48px;
        height: 48px;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--surface);
        color: var(--ink);
        transition:
            background-color 160ms var(--ease-out),
            color 160ms var(--ease-out),
            border-color 160ms var(--ease-out);
    }
    .back-to-top:focus-visible {
        background-color: var(--ink);
        color: var(--surface);
        border-color: var(--ink);
        outline-color: var(--ink);
    }
    @media (hover: hover) and (pointer: fine) {
        .contact-links a:hover :global(svg) {
            transform: translate(2px, -2px);
        }
        .back-to-top:hover {
            background-color: var(--ink);
            color: var(--surface);
            border-color: var(--ink);
        }
    }
    @media (max-width: 767px) {
        .contact-layout {
            grid-template-columns: 1fr;
            gap: 40px;
        }
    }
    @media (max-width: 639px) {
        .closing h2 {
            font-size: clamp(44px, 11.5vw, 64px);
        }
        .contact-description {
            font-size: 16px;
            margin-bottom: 24px;
        }
        .contact-links {
            display: grid;
            grid-template-columns: repeat(2, max-content);
            gap: 12px 28px;
        }
        .contact-links a {
            font-size: 18px;
        }
        .footer-bottom {
            padding-inline: 56px;
        }
        .copyright {
            display: block;
            margin: 8px 0 0;
        }
    }
</style>
