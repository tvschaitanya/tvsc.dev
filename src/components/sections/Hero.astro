---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const introduction = {
  firstName: 'Chaitanya',
  role: 'Cloud & AI Engineer',
  introduction: 'I connect business needs with practical cloud and AI solutions.',
  summary: 'Hands-on experience in development, production operations, and automation shapes how I balance cost, reliability, and complexity.',
};
---
<section id="home" class="hero" data-enter aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true">
    <div class="ambient-grid"></div>
    <div class="grid-pattern-glow"></div>
  </div>
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="hello" data-hero-item>Hello, I’m</p>
      <h1 id="hero-title" data-hero-line>{introduction.firstName}</h1>
      <p class="role" data-hero-line>{introduction.role}</p>
      <div class="hero-description" data-hero-item>
        <p>{introduction.introduction}</p>
        <p>{introduction.summary}</p>
      </div>
      <div class="hero-actions" data-hero-item>
        <Button href="#contact">Let’s Connect</Button>
        <a class="about-link" href="#projects">See my work <Icon name="down" size={17} /></a>
      </div>
    </div>
  </div>
</section>
<style>
  .hero { position:relative;isolation:isolate;overflow:hidden;background:var(--bg);padding:calc(var(--nav-height) + 136px) 0 152px; }
  .hero-atmosphere { position:absolute;inset:0;z-index:-1;pointer-events:none; }
  .ambient-grid { position:absolute;inset:0;background-image:linear-gradient(color-mix(in srgb,var(--ink) 11%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--ink) 11%,transparent) 1px,transparent 1px);background-size:56px 56px;mask-image:radial-gradient(ellipse at center,transparent 4%,black 85%); }
  .grid-pattern-glow {
    position:absolute;inset:0;
    background-image:linear-gradient(color-mix(in srgb,var(--blue) 85%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,var(--blue) 85%,transparent) 1px,transparent 1px);
    background-size:56px 56px;
    mask-image:repeating-linear-gradient(135deg,transparent 0px,transparent 70px,rgba(0,0,0,.25) 100px,black 150px,black 190px,rgba(0,0,0,.25) 240px,transparent 280px,transparent 336px);
    mask-size:475px 475px;
    mask-repeat:repeat;
    filter:drop-shadow(0 0 4px var(--blue));
    opacity:.6;
  }
  .hero-atmosphere { mask-image:radial-gradient(ellipse at center,rgba(0,0,0,.1) 10%,rgba(0,0,0,.5) 45%,black 85%); }
  @media(prefers-reduced-motion:no-preference) {
    .grid-pattern-glow { animation:grid-wave 8s linear 3; }
  }
  @keyframes grid-wave {
    0% { mask-position:0 0;opacity:.35; }
    25% { opacity:.9; }
    50% { opacity:.65; }
    75% { opacity:.9; }
    100% { mask-position:475px 475px;opacity:.35; }
  }
  @media(prefers-reduced-motion:reduce) { .grid-pattern-glow { opacity:.25; } }
  .hero-inner { display:flex;justify-content:center; }
  .hero-copy { width:100%;max-width:1120px;text-align:center; }
  .hello { font-size:16px;color:var(--muted);margin:0 0 10px; }
  h1 { font-size:clamp(48px,5.5vw,72px);font-weight:500;line-height:1.1;letter-spacing:-.055em;margin:0 0 16px;color:var(--ink); }
  .name-dot { color:var(--blue); }
  .role { font:400 clamp(21px,2.2vw,28px)/1.35 var(--font-display);letter-spacing:-.025em;color:var(--ink);margin:0 0 28px; }
  .hero-description { max-width:1100px;margin:0 auto 32px; }
  .hero-description p { font-size:18px;line-height:1.75;color:var(--ink);margin:0;text-wrap:balance; }
  .hero-description p+p { margin-top:12px; }
  .hero-actions { display:flex;justify-content:center;align-items:center;gap:28px; }
  .about-link { display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;font-size:14px; }
  .about-link :global(svg) { color:var(--muted);transition:transform 160ms var(--ease-out); }
  @media(hover:hover) and (pointer:fine) { .about-link:hover :global(svg) { transform:translateY(3px); } }
  @media(max-width:767px) { .hero { padding:calc(var(--nav-height) + 112px) 0 128px; }.hero-copy { max-width:680px; } }
  @media(max-width:639px) {
    .hero { padding:calc(var(--nav-height) + 80px) 0 96px; }
    h1 { font-size:48px; }
    .role { font-size:23px;margin-bottom:24px; }
    .hero-description p { font-size:17px;line-height:1.7; }
    .hero-actions { flex-direction:column;gap:12px;width:min(100%,300px);margin-inline:auto; }
    .about-link { width:100%; }
  }
</style>
