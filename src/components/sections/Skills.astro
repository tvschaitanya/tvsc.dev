---
import { Cloud, Cpu, CodeXml, Database } from '@lucide/astro';
import TechnologyIcon from '../ui/TechnologyIcon.astro';
const skills = [
  { name: 'AI Systems', icon: Cpu, description: 'Building AI assistants from content preparation and retrieval through agent workflows, source-linked answers, evaluation, and tracing.', tools: ['Amazon Bedrock', 'pydantic-ai', 'RAG', 'MCP', 'Firecrawl', 'Titan Embeddings', 'Weaviate', 'Hybrid Search', 'Exa', 'Langfuse', 'LLM Evaluation'] },
  { name: 'Cloud & DevOps', icon: Cloud, description: 'Deploying services on AWS, managing infrastructure, automating delivery, and monitoring production systems.', tools: ['AWS', 'AWS Lambda', 'Amazon S3', 'Terraform', 'Ansible', 'Linux', 'Docker', 'Kubernetes', 'GitHub Actions', 'Argo CD', 'Jenkins', 'CloudWatch', 'OpenTelemetry', 'Incident Response'] },
  { name: 'Programming & APIs', icon: CodeXml, description: 'Building APIs with input validation and streamed responses, web interfaces, and automation scripts.', tools: ['Python', 'FastAPI', 'TypeScript', 'Astro', 'Bash', 'Java'] },
  { name: 'Databases', icon: Database, description: 'Working with relational and NoSQL databases to store, organise, and query application data.', tools: ['PostgreSQL', 'MySQL', 'SQL Server', 'MongoDB', 'Amazon DynamoDB'] },
] as const;
import SectionLabel from '../ui/SectionLabel.astro';
---
<section id="skills" class="section skills" aria-labelledby="skills-title">
  <div class="wrap">
    <SectionLabel number="03" label="Skills" />
    <div class="skills-heading">
      <h2 id="skills-title">Tools I <br />work with<span class="orange">.</span></h2>
    </div>
    <div class="skill-list">
      {skills.map(skill => (
        <article class="skill-row">
          <div class="skill-summary">
            <skill.icon size={25} stroke-width={1.75} aria-hidden="true" />
            <div class="skill-copy">
              <h3>{skill.name}</h3>
              <p>{skill.description}</p>
            </div>
          </div>
          <ul aria-label={`${skill.name} tools`}>
            {skill.tools.map(tool => <li><TechnologyIcon name={tool} /><span>{tool}</span></li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .skills { background:var(--surface); }
  .skills-heading { margin-bottom:40px; }
  .skills-heading h2 { margin:0; }
  .skill-list { border-top:1px solid var(--line); }
  .skill-row { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:64px;align-items:center;border-bottom:1px solid var(--line);padding:28px 0; }
  .skill-summary { display:flex;gap:20px;align-items:flex-start;min-width:0; }
  .skill-summary :global(svg) { box-sizing:content-box;color:var(--paper);background:var(--blue);padding:12px;border:1px solid var(--deep);border-radius:8px;box-shadow:3px 3px 0 var(--ink);flex-shrink:0; }
  .skill-copy { min-width:0; }
  .skill-copy h3 { font-size:20px;line-height:1.3;font-weight:500;letter-spacing:-.025em;margin:0 0 8px; }
  .skill-copy p { font-size:14px;line-height:1.65;color:var(--muted);margin:0;max-width:440px; }
  .skill-row ul { list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px; }
  .skill-row li { display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:4px;background:var(--bg);padding:6px 10px;font-size:13px;line-height:1.4; }
  .skill-row li :global(svg) { flex-shrink:0;color:var(--ink); }
  @media(max-width:1023px) { .skill-row { gap:32px; }.skill-summary { gap:16px; }.skills-heading { margin-bottom:32px; } }
  @media(max-width:639px) {
    .skill-row { grid-template-columns:1fr;gap:20px;padding:28px 0; }
    .skill-copy h3 { font-size:20px; }
    .skill-copy p { font-size:14px; }
    .skill-row li { font-size:12px; }
  }
</style>
