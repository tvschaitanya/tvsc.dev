---
const siteName = "Chaitanya's Portfolio";
const navigation = [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Projects', href: '#projects' },
  { label: 'Skills', href: '#skills' },
  { label: 'Blogs', href: '#blogs' },
  { label: 'Contact', href: '#contact' },
];
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-header nav nav--centre"><div class="wrap header-inner"><a class="skip-link" href="#main">Skip to content</a><a class="brand" href="#home" aria-label={`${siteName} — Home`}><span class="brand-mark" aria-hidden="true">c<span>.</span></span><span>Chaitanya<span class="brand-detail">'s Portfolio</span></span></a><nav class="navigation" aria-label="Main navigation">{navigation.map(({label,href}) => <a class:list={['nav-link', { 'is-active': label === 'Home' }]} href={href} aria-current={label === 'Home' ? 'location' : undefined}>{label}</a>)}</nav><ThemeToggle /></div></header>
<script>
  import { initNavigation } from '../scripts/navigation';
  initNavigation();
</script>
<style>
  .site-header { position:fixed; inset:0 0 auto; height:var(--nav-height); z-index:20; background:var(--bg); border-bottom:1px solid var(--line); }
  .header-inner { height:100%; display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .brand { min-height:44px;display:flex; align-items:center; gap:12px; font-size:15px; font-weight:500; white-space:nowrap; }
  .brand-mark { font:600 40px/.8 var(--font-display); letter-spacing:-5px; margin-right:6px; }.brand-mark { color:var(--blue); }.brand-mark span { color:var(--orange); }
  .navigation { display:flex; gap:28px; height:100%; align-items:center; }
  .nav-link { display:flex; align-items:center; min-height:44px; font-size:14px; color:var(--muted); position:relative; }
  .nav-link:after { content:''; position:absolute; left:0; right:0; bottom:3px; height:2px; background:var(--blue); transform:scaleX(0); transform-origin:left; transition:transform 160ms var(--ease-out); }
  .nav-link.is-active { color:var(--ink); }.nav-link.is-active:after { transform:scaleX(1); }
  @media(hover:hover) and (pointer:fine) { .nav-link:hover { color:var(--ink); }.nav-link:hover:after { transform:scaleX(1); } }
  @media(max-width:1100px) { .brand-detail { display:none; }.navigation { gap:16px; } }
  @media(max-width:767px) { .header-inner { flex-wrap:wrap; gap:0 16px; align-content:center; }.brand { font-size:15px; }.brand-mark { font-size:34px; }.navigation { order:3; width:100%; justify-content:space-between; height:44px; margin-top:6px; gap:0; }.nav-link { font-size:13px; justify-content:center; min-width:44px; } }
</style>
