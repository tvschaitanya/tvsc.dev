---
interface Props {
    number: string;
    label: string;
    note?: string;
}
const { number, label, note } = Astro.props;
---

<div class="section-label">
    <span>
        <span class="index">{number}</span> / {label}
    </span>
    {note && <span class="note">{note}</span>}
</div>
<style>
    .section-label {
        display: flex;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 48px;
        font: 400 13px/1.5 var(--font-mono);
        color: var(--muted);
    }
    .index {
        color: var(--accent);
    }
    .note {
        text-align: right;
    }
    @media (max-width: 639px) {
        .section-label {
            margin-bottom: 32px;
            font-size: 12px;
        }
        .note {
            display: none;
        }
    }
</style>
