---
import Icon from './Icon.astro';
interface Props { href: string; variant?: 'primary' | 'secondary'; external?: boolean; }
const { href, variant = 'primary', external = false } = Astro.props;
---
<a class:list={['button', `button--${variant}`]} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}><span><slot /></span><Icon size={19} /></a>
<style>
  .button { min-height: 52px; display: inline-flex; align-items: center; justify-content: space-between; gap: 40px; padding: 12px 24px; border: 2px solid var(--deep); border-radius: 7px; font-size: 16px; font-weight: 500; transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease; }
  .button--primary { background:var(--blue);color:var(--paper);box-shadow:4px 4px 0 var(--ink); }
  .button--secondary { border-color: var(--line); color: var(--ink); }
  .button :global(svg) { transition: transform 160ms var(--ease-out); }
  @media(hover:hover) and (pointer:fine) { .button:hover { transform: translateY(-2px); } .button:hover :global(svg) { transform: translate(2px,-2px); } }
  .button:active { transform: translate(2px,2px); }
  @media(max-width:639px) { .button { width: 100%; } }
</style>
